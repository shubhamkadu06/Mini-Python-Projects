import tkinter as tk
from time import strftime

def update_time():
    # Fetch the current system time in HH:MM:SS AM/PM format
    # Use '%H:%M:%S' instead if you prefer 24-hour format
    time_string = strftime('%I:%M:%S %p')
    
    # Update the text of the clock label
    clock_label.config(text=time_string)
    
    # Call the update_time function again after 1000 milliseconds (1 second)
    clock_label.after(1000, update_time)

# Initialize the main application window
root = tk.Tk()
root.title("Digital Clock")

# Configure the appearance of the clock label
clock_label = tk.Label(
    root, 
    font=('Calibri', 50, 'bold'), 
    background='black', 
    foreground='cyan'
)

# Pack the label into the window with some padding
clock_label.pack(anchor='center', padx=20, pady=20)

# Run the update function for the first time
update_time()

# Start the Tkinter event loop to keep the window open
root.mainloop()
